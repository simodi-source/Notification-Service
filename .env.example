# Copy to .env and fill values. Never commit real secrets.

REDIS_URL=
MONGODB_URI=

# Environment label inside Slack/API messages (development / test / production).
# Admin panel OTP Slack is also hard-blocked when NODE_ENV=production.
NODE_ENV=development

BIRD_API_KEY=
BIRD_API_BASE_URL=
MAIL_FROM=
MAIL_FROM_NAME=Simodi
MAIL_BRAND_LOGO_URL=

FIREBASE_SERVICE_ACCOUNT_PATH=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Telesom Standard SMS Messaging API (OTP delivery only — not Telesom OTP API)
TELESOM_SMS_URL=https://sms.mytelesom.com/index.php/smsapi/v1/messages
TELESOM_SENDER_ID=SIMODIGOLD
TELESOM_USERNAME=
TELESOM_PASSWORD=
TELESOM_SHARED_SECRET=
TELESOM_CLIENT_REF=SIMODI-OTP

# Somtel SMS API (eDahab OTP only). Username/password required only when sending via Somtel.
SOMTEL_BASE_URL=https://smsapi.somtelsomalia.com
SOMTEL_USERNAME=
SOMTEL_PASSWORD=
SOMTEL_TOKEN_PATH=/token
SOMTEL_SEND_PATH=/api/SendSMS

NOTIFICATION_WORKER_CONCURRENCY=5

# Same Slack app, one Incoming Webhook per channel (JSON map).
SLACK_WEBHOOKS={"admin_otp":"https://hooks.slack.com/services/...","engineering":"https://hooks.slack.com/services/..."}
# Legacy single webhook — still accepted as admin_otp if SLACK_WEBHOOKS.admin_otp is unset.
# SLACK_WEBHOOK_URL=

# --- Slack delivery toggles (true/false). ---
# Admin panel MFA OTP → admin_otp webhook only. Ignored in production even if true.
SLACK_ADMIN_OTP_ENABLED=true
# Engineering crash/incident alerts → engineering webhook only (no fallback).
ENGINEERING_SLACK_ALERTS_ENABLED=true

# Unmapped events never post to Slack. Do not list auth/KYC/login OTP here.
# SLACK_EVENTS=
# Only admin.mfa_otp uses admin_otp. Only ops.engineering_incident uses engineering.
# SLACK_EVENT_CHANNELS={"admin.mfa_otp":"admin_otp","ops.engineering_incident":"engineering"}

# Optional public HTTPS URL for Slack image block (Trace reference screenshot).
# ENGINEERING_ALERT_CONTEXT_IMAGE_URL=https://your-cdn.example/error-trace-reference.png
